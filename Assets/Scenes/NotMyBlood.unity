      m_Calls: []
  m_text: "<b>E</b> auf einen Mitspieler: <b>Nadeltest</b> \u2192 Blutgruppe.\n<size=80%><color=#7a5a3c>2 pro Runde. Er merkt, dass du es warst!</color></size>\n\n<b>Shift</b> (ducken) + <b>E halten</b>: <b>Foto vom Schuh</b> \u2192 Schuhprofil.\n<size=80%><color=#7a5a3c>Unbegrenzt, aber du musst nah ran.</color></size>\n\n<b>Kleidung</b> siehst du einfach.\n\nKlick auf einen <b>Stempel</b>: unklar \u2192 verd\xE4chtig \u2192 entlastet."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2a6829fce0c0b426da043b06ff1fdde2, type: 2}
